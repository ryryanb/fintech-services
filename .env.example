# Local Docker Compose configuration (copy to .env; never commit .env)
# These are development-only examples. Replace passwords before use.
AUTH_DB_NAME=auth_db
AUTH_DB_USERNAME=saas_user
AUTH_DB_PASSWORD=

CUSTOMER_DB_NAME=customer_db
CUSTOMER_DB_USERNAME=saas_user
CUSTOMER_DB_PASSWORD=

ACCOUNT_DB_NAME=account_db
ACCOUNT_DB_USERNAME=saas_user
ACCOUNT_DB_PASSWORD=

TRANSACTION_DB_NAME=transaction_db
TRANSACTION_DB_USERNAME=saas_user
TRANSACTION_DB_PASSWORD=

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USERNAME=saas_user
PAYMENT_DB_PASSWORD=

# Stripe test-mode secret key (starts with sk_test_). Never use a live key locally.
STRIPE_SECRET_KEY=

# PayPal sandbox REST app credentials. Never use live credentials locally.
# Create an app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
FRONTEND_BASE_URL=http://localhost:5173
